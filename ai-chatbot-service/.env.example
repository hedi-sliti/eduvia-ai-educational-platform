# Eduvia AI Chatbot Service Environment Configuration

# Application Settings
PROJECT_NAME=Eduvia AI Chatbot Service
API_V1_STR=/api
ENVIRONMENT=development

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
# Local demo model used for the defense flow.
OLLAMA_MODEL=tinyllama
# Faster embedding model to keep retrieval responsive even with large chat models.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Database Configuration
MYSQL_URL=mysql+pymysql://root:password@localhost/eduvia_chatbot

# Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/app.log

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
